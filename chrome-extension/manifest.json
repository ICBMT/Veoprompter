{
  "manifest_version": 3,
  "name": "VeoPrompter for Google Flow",
  "version": "1.5.0",
  "description": "Copy and paste prompt parts into the next text field you click on the active tab.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "VeoPrompter prompt handoff",
    "default_popup": "popup.html"
  }
}
