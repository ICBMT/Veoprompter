{
  "manifest_version": 3,
  "name": "VeoPrompter for Google Flow",
  "version": "1.0.0",
  "description": "Paste VeoPrompter context and clip prompts into Google Flow one part at a time.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "VeoPrompter Flow handoff",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://flow.google/*"
      ],
      "js": ["flow-content.js"],
      "run_at": "document_idle"
    }
  ]
}
