{
  "manifest_version": 3,
  "name": "VeoPrompter for Google Flow",
  "version": "1.2.0",
  "description": "Copy prompts or fill Google Flow's prompt box one part at a time.",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "VeoPrompter prompt handoff",
    "default_popup": "popup.html"
  }
}
